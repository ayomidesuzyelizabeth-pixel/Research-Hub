# ============================================================================
# RESEARCH DESK — Environment Configuration Template
# Team Faith & Ayomide
# ============================================================================

# Server Port & Runtime
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Live Google Search Grounding & Synthesis)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (PostgreSQL, Auth, Storage)
# Obtain from your Supabase Dashboard: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_key_here

# Polite Pool Contact Email (for OpenAlex and Crossref APIs)
# Adding your email routes queries to the fast polite queue
POLITE_POOL_EMAIL=teamfaith.ayomide@desk.local

# Optional: Semantic Scholar API Key (higher rate limit, though works without key)
SEMANTIC_SCHOLAR_API_KEY=
